# Para cargar estas variables: node --env-file=.env lite-server.js
PORT=3000
HOST=127.0.0.1
LINGOLITE_DATABASE_PATH=./data/lingolite.sqlite
COOKIE_SECURE=false

# Base persistente para Vercel. Si no se indican, se usa la integración TURSO_* existente.
# LINGOLITE_DATABASE_URL=libsql://tu-base.turso.io
# LINGOLITE_DATABASE_TOKEN=

# Opcional: traducción de texto con consentimiento de ambos participantes.
# LINGOLITE_TRANSLATE_URL=https://tu-proveedor.example/translate
# LINGOLITE_TRANSLATE_KEY=
# Alternativa solo local si Ollama ya está instalado y ejecutándose:
# LINGOLITE_OLLAMA_MODEL=qwen3.5:4b

# STUN para conexión directa; dejarlo vacío desactiva el STUN externo.
# LINGOLITE_STUN_URL=stun:stun.l.google.com:19302
# TURN compatible con coturn para conexiones que no puedan establecerse directamente.
# LINGOLITE_TURN_URL=turn:turn.example.com:3478
# LINGOLITE_TURN_SECRET=
