# Node no carga este archivo automáticamente. Usa: node --env-file=.env server.js
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/lingodate.sqlite
# Usa HTTPS y COOKIE_SECURE=true al desplegar públicamente.
COOKIE_SECURE=false
# Opcional: endpoint /translate de tu proveedor LibreTranslate.
# Si se configura, los mensajes reales se envían a este proveedor para traducirlos.
# TRANSLATE_URL=https://tu-proveedor.example/translate
# TRANSLATE_API_KEY=
# Opcional: traducción + lectura fonética del ORIGINAL mediante OpenAI.
# Solo se habilita si seleccionas explícitamente este proveedor.
# LANGUAGE_PROVIDER=openai
# OPENAI_API_KEY=
# LANGUAGE_MODEL=gpt-4.1-mini
